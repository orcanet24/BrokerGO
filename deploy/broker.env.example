# Example environment file for /etc/broker/broker.env
# Install with: sudo install -m 0600 broker.env.example /etc/broker/broker.env

BROKER_ENV=production
BROKER_NODE_ID=vps1

# Public TLS (autocert / Let's Encrypt) — port 443
BROKER_LISTEN_ADDR=:443
BROKER_ACME_ENABLED=true
BROKER_ACME_EMAIL=tu@correo.com
BROKER_ACME_DOMAIN=broker.tudominio.com
BROKER_ACME_CACHE_DIR=/var/lib/broker/acme

# Internal gRPC for backends (keep loopback or private net — NOT public)
BROKER_GRPC_ADDR=127.0.0.1:9090

# JWT (EdDSA) issued by your backend
BROKER_JWT_ISSUER=https://api.tudominio.com
BROKER_JWT_AUDIENCE=broker
BROKER_JWT_PUBLIC_KEYS_DIR=/etc/broker/jwks

# Redis bus (TLS + AUTH). Master on this node example; replicas use
# BROKER_REDIS_ROLE=replica and BROKER_REDIS_MASTER_ADDR=<master-ip>:6380
BROKER_REDIS_ENABLED=true
BROKER_REDIS_ADDR=127.0.0.1:6380
BROKER_REDIS_PASSWORD_FILE=/etc/broker/redis.pass
BROKER_REDIS_TLS=true
BROKER_REDIS_ROLE=master

# Limits (defaults are safe; tune under measurement)
BROKER_MAX_CONNS=10000
BROKER_MAX_CONNS_PER_IP=32
BROKER_MAX_FRAME_BYTES=65536
BROKER_MAX_SUBS_PER_CONN=64
BROKER_RATE_LIMIT_PPS=100
BROKER_RATE_LIMIT_PUB_PS=20
